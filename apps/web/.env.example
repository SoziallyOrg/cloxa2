NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
CLOXA_SITE_URL=http://localhost:3000

# Server-only secrets (>=32 chars each, all different). Generate with: openssl rand -base64 48
AUTH_HASH_PEPPER=
FLOW_COOKIE_SECRET=

# REQUIRED in production: vercel | append:<n> | none
CLOXA_PROXY_MODE=none
# Optional Cloudflare Turnstile (set both or neither)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=