{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm vitest run*)",
      "Bash(pnpm test*)",
      "Bash(pnpm db:test*)",
      "Bash(pnpm db:types*)",
      "Bash(pnpm exec prettier --check*)",
      "Bash(pnpm supabase status*)",
      "Bash(supabase status*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(git push --force*)"
    ]
  }
}
