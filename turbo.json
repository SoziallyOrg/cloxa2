{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "SUPABASE_SECRET_KEY",
        "CLOXA_SITE_URL",
        "AUTH_HASH_PEPPER",
        "FLOW_COOKIE_SECRET",
        "CLOXA_PROXY_MODE",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "EXPORT_SIGNING_KEY",
        "EXPORT_SIGNING_KEY_ID",
        "EXPORT_VERIFY_KEYS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
