# Copy to .env.production next to docker-compose.yml on the VPS and fill in
# real values. Loaded into the `app` container via `env_file:` — never baked
# into the image, never committed. chmod 600 it on the server.
#
# Schema source of truth: apps/web/src/lib/env.ts and
# apps/web/src/lib/env.server.ts (both validate with zod at startup).

# --- Supabase (Frankfurt project) -------------------------------------------
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Project Settings > API > service_role key. Full DB access — never expose to
# the browser, never log it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- App -----------------------------------------------------------------
# Cloxa's own public URL. Used server-side for redirects and email links.
# (The Server Actions allowed-origin check is baked in at build time from
# the same value — see apps/web/next.config.ts — so this should match.)
CLOXA_SITE_URL=https://cloxa.app

# HMAC key for the auth attempt limiter's hashed email/IP lookups.
# Generate: openssl rand -base64 48
AUTH_HASH_PEPPER=

# HMAC key for Cloxa's own signed cookies (login flow, org choice, activity).
# Generate: openssl rand -base64 48
# Must differ from AUTH_HASH_PEPPER and SUPABASE_SECRET_KEY.
FLOW_COOKIE_SECRET=

# Which header carries the real client IP. On this deploy, Caddy is the only
# proxy in front of the app and appends (rather than trusts or strips) the
# peer address to X-Forwarded-For, so the app must read the right-most hop.
# See deploy/Caddyfile and apps/web/src/lib/auth/hash.ts.
CLOXA_PROXY_MODE=append:1

# --- Export signing (Ed25519) ----------------------------------------------
# Signs downloadable time-record exports so recipients can verify authenticity.
# Generate a PKCS8 private key, base64-encoded (single line):
#   node -e "const {generateKeyPairSync}=require('node:crypto');const {privateKey}=generateKeyPairSync('ed25519');process.stdout.write(Buffer.from(privateKey.export({format:'pem',type:'pkcs8'})).toString('base64'))"
EXPORT_SIGNING_KEY=
# A short label published alongside the public key so verifiers pick the
# right one when it's rotated. e.g. 2026-01
EXPORT_SIGNING_KEY_ID=

# Retired public keys that should still verify older exports after a
# rotation. JSON list of {"kid": "...", "publicKeyJwk": {...}}. Leave unset
# until the first rotation.
# EXPORT_VERIFY_KEYS=

# --- Cloudflare Turnstile (optional; on when both are set) -----------------
# https://dash.cloudflare.com/ > Turnstile. Leave both unset to disable.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
